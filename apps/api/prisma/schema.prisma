generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String     @unique @db.VarChar(255)
  password_hash         String     @db.VarChar(255)
  name                  String     @db.VarChar(255)
  sleep_time_start      DateTime?  @db.Time(6)
  sleep_time_end        DateTime?  @db.Time(6)
  productive_time_start DateTime?  @db.Time(6)
  productive_time_end   DateTime?  @db.Time(6)
  onboarding_status     Boolean?   @default(false)
  refresh_token         String?
  created_at            DateTime?  @default(now()) @db.Timestamptz(6)
  courses               Course[]
  routines              Routine[]
  schedules             Schedule[]
  tasks                 Task[]

  @@map("users")
}

model Course {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String     @db.Uuid
  name             String     @db.VarChar(255)
  confidence_level Int
  created_at       DateTime?  @default(now()) @db.Timestamptz(6)
  user             User       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  routines         Routine[]
  schedules        Schedule[]
  tasks            Task[]

  @@map("courses")
}

model Routine {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  course_id    String?   @db.Uuid
  title        String    @db.VarChar(255)
  day_of_week  String    @db.VarChar(20)
  start_time   DateTime  @db.Time(6)
  end_time     DateTime  @db.Time(6)
  is_cancelled Boolean?  @default(false)
  source       String?   @db.VarChar(50)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  course       Course?   @relation(fields: [course_id], references: [id], onUpdate: NoAction)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("routines")
}

model Schedule {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String    @db.Uuid
  task_id               String?   @db.Uuid
  course_id             String?   @db.Uuid
  session_type          String    @db.VarChar(50)
  start_time            DateTime  @db.Timestamptz(6)
  end_time              DateTime  @db.Timestamptz(6)
  completion_status     String?   @default("Belum") @db.VarChar(50)
  actual_duration_hours Float?
  new_confidence_rating Int?
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  course                Course?   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  task                  Task?     @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                  User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([start_time, end_time], map: "idx_schedules_time")
  @@map("schedules")
}

model Task {
  id                       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String     @db.Uuid
  course_id                String     @db.Uuid
  title                    String     @db.VarChar(255)
  task_type                String?    @db.VarChar(100)
  task_size                Int?
  deadline                 DateTime   @db.Timestamptz(6)
  estimated_duration_hours Float?
  priority_score           Decimal?   @db.Decimal(5, 2)
  predicted_input          Json?
  predicted_min_hours      Float?
  predicted_max_hours      Float?
  influencing_factors      Json?
  model_version            String?    @db.VarChar(50)
  predicted_at             DateTime?  @db.Timestamptz(6)
  actual_duration_hours    Float?
  completion_status        String?    @default("Belum") @db.VarChar(50)
  created_at               DateTime?  @default(now()) @db.Timestamptz(6)
  schedules                Schedule[]
  course                   Course     @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                     User       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([completion_status], map: "idx_tasks_completion_status")
  @@index([deadline], map: "idx_tasks_deadline")
  @@map("tasks")
}
